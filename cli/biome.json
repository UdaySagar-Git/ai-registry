        "test/e2e/publish.test.ts",
        "test/e2e/registry-catalog.test.ts",
        "test/e2e/surface-argv.test.ts",
        "test/e2e/watch-jobs.test.ts",
        "test/kit/scenario.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConditionalExpect": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/accounts/service.test.ts",
        "src/adapter/files.ts",
