        "src/cli/commands/add.ts",
        "src/cli/commands/daemon.ts",
        "src/cli/commands/job.ts",
        "src/cli/commands/job/runs.test.ts",
        "src/cli/commands/job/runs.ts",
        "src/cli/commands/list.ts",
        "src/cli/commands/publish.ts",
        "src/cli/commands/registry.ts",
        "src/cli/commands/remove.ts",
        "src/cli/commands/status.ts",
        "src/cli/commands/sync.ts",
        "src/cli/commands/watch.ts",
        "src/cli/console/ui/app.ts",
        "src/cli/onboarding/import.test.ts",
        "src/cli/render/status.ts",
        "src/cli/render/tools.ts",
        "src/core/adapter/load.ts",
        "src/core/console/artifacts.ts",
        "src/core/console/failure-reasons.test.ts",
        "src/core/credentials/store.test.ts",
        "src/core/env.ts",
        "src/core/filespec/indexer.test.ts",
        "src/core/filespec/kind-manifests.ts",
        "src/core/filespec/offer.ts",
        "src/core/filespec/validate.test.ts",
        "src/core/filespec/validate.ts",
        "src/core/fs/digest.ts",
        "src/core/fs/tree.test.ts",
        "src/core/fs/tree.ts",
        "src/core/hook/run.test.ts",
        "src/core/lease/lease.fs-faults.test.ts",
        "src/core/lock.test.ts",
        "src/core/manifest/parse.ts",
        "src/core/plan/apply/journal.ts",
        "src/core/plan/apply/record.ts",
        "src/core/plan/build/build.ts",
        "src/core/plan/build/carry.ts",
        "src/core/plan/carries.ts",
        "src/core/plan/status.ts",
        "src/core/store/paths.ts",
        "src/core/target/placement.ts",
