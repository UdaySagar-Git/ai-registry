{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "Index document",
  "description": "The index.json document at a root. One entry per (namespace, kind, name), with the latest version, its digests, and its status. What a client downloads once and searches offline. Generated from the versions documents and never hand-edited. File spec section 3.2.",
  "type": "object",
  "properties": {
    "format_version": { "$ref": "common.schema.json#/$defs/format_version" },
    "generated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "description": "Entries MUST be unique on (namespace, kind, name) and MUST agree with the versions documents. Neither rule is expressible in JSON Schema; the checker enforces both.",
      "items": {
        "type": "object",
        "properties": {
          "namespace": { "$ref": "common.schema.json#/$defs/namespace" },
          "kind": { "$ref": "common.schema.json#/$defs/kind" },
          "name": { "$ref": "common.schema.json#/$defs/name" },
          "latest": { "$ref": "common.schema.json#/$defs/version" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" },
          "catalog_digest": { "$ref": "common.schema.json#/$defs/digest" },
          "status": { "$ref": "common.schema.json#/$defs/status" },
          "display_name": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 },
          "labels": { "$ref": "common.schema.json#/$defs/labels" },
          "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
        },
        "required": ["namespace", "kind", "name", "latest", "digest", "status"]
      }
    }
  },
  "required": ["format_version", "generated_at", "entries"]
}
