        "src/cli/commands/self/update.ts",
        "src/cli/console/ui/app.ts",
        "src/cli/console/ui/views/artifacts.ts",
        "src/cli/console/ui/views/overview.ts",
        "src/cli/options.ts",
        "src/cli/prompt/flow.ts",
        "src/cli/prompt/layout.ts",
        "src/cli/prompt/multiselect.ts",
        "src/cli/prompt/tree.ts",
        "src/cli/render/plan.ts",
        "src/cli/render/run.ts",
        "src/cli/suggest.ts",
        "src/core/adapter/materialize.ts",
        "src/core/filespec/kind-manifests.ts",
        "src/core/filespec/schema.ts",
        "src/core/filespec/validate.ts",
        "src/core/fs/digest.ts",
        "src/core/plan/acquire.ts",
        "src/core/plan/apply/link.ts",
        "src/core/plan/build/restage.ts",
        "src/core/sync/index.ts",
        "src/core/sync/scan.ts",
        "src/core/target/check.ts",
        "src/core/target/register/register.ts",
        "src/core/target/register/toml.ts",
        "src/core/term/format.ts",
        "src/daemon/rpc/errors.ts",
        "src/engine/publish/files.ts",
        "src/engine/publish/target.ts",
        "src/engine/publish/work.ts",
        "src/engine/sync/publish-settle.ts",
        "src/main.ts",
        "test/conformance/kit.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/adapter/files.test.ts",
        "src/cli/argv.test.ts",
        "src/cli/commands/daemon.test.ts",
        "src/cli/console/actions.test.ts",
        "src/core/fs/tree.test.ts",
        "src/core/kinds.test.ts",
